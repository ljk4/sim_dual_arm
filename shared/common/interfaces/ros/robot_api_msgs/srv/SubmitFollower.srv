# Submit an already generated trajectory for validation and execution.
# The accompanying raw command retains the source window and hand-off anchor.
robot_api_msgs/StreamCommand request
robot_api_msgs/ReferenceSegment[<=128] segments
---
bool accepted
string reason
bool has_execution
robot_api_msgs/ExecutionFeedback execution
bool has_chunk
robot_api_msgs/StreamChunkStatus chunk
bool has_reference
robot_api_msgs/FollowerReference reference
