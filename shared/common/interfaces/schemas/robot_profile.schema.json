{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "test_only": {
      "type": "boolean"
    },
    "robot_id": {
      "type": "string",
      "minLength": 1
    },
    "profile_id": {
      "type": "string",
      "minLength": 1
    },
    "joints": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "unit": {
            "enum": [
              "rad",
              "m"
            ]
          },
          "min": {
            "type": "number"
          },
          "max": {
            "type": "number"
          },
          "max_velocity": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "initial": {
            "type": "number"
          }
        },
        "required": [
          "name",
          "unit",
          "min",
          "max",
          "max_velocity",
          "initial"
        ]
      }
    },
    "cameras": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,63}$"
          },
          "width": {
            "type": "integer",
            "minimum": 1,
            "maximum": 4096
          },
          "height": {
            "type": "integer",
            "minimum": 1,
            "maximum": 4096
          },
          "frame_id": {
            "type": "string",
            "minLength": 1
          },
          "calibration_digest": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        },
        "required": [
          "name",
          "width",
          "height",
          "frame_id",
          "calibration_digest"
        ]
      }
    }
  },
  "required": [
    "test_only",
    "robot_id",
    "profile_id",
    "joints",
    "cameras"
  ]
}
