{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Formal rollout selection manifest",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "campaign": {
      "type": "string",
      "minLength": 1
    },
    "diagnostic": {
      "type": "boolean"
    },
    "target": {
      "type": "integer",
      "minimum": 1
    },
    "rule": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "enum": [
        "SELECTED",
        "INSUFFICIENT_QUALIFIED"
      ]
    },
    "qualified": {
      "type": "integer",
      "minimum": 0
    },
    "selected": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/selectedAttempt"
      }
    }
  },
  "required": [
    "campaign",
    "diagnostic",
    "target",
    "rule",
    "status",
    "qualified",
    "selected"
  ],
  "$defs": {
    "selectedAttempt": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "attempt_id": {
          "type": "string",
          "minLength": 1
        },
        "seed": {
          "type": "integer",
          "minimum": 0
        },
        "attempt_dir": {
          "type": "string",
          "minLength": 1
        },
        "raw_bytes": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "attempt_id",
        "seed",
        "attempt_dir",
        "raw_bytes"
      ]
    }
  }
}
