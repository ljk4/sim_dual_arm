# 中文参数说明（维护时优先阅读本段）
# PROJECT_ROOT：仿真项目根目录。
# PROJECT_SOURCE_ROOT：仿真源码目录。
# PROJECT_CONTAINER：标记当前运行在项目容器内。
# PROJECT_USE_ROS：是否加载 ROS 环境。
# ROS_DOMAIN_ID：ROS 2 域 ID，三端必须一致。
# PROJECT_SETUP：容器环境初始化脚本。
# PROJECT_SOURCE_PATHS：容器内 Python 源码搜索路径。
# MUJOCO_GL：MuJoCo 默认 OpenGL 后端；headless 渲染使用 egl。
# PYOPENGL_PLATFORM：PyOpenGL 后端；headless 渲染使用 egl。
# ROS_LOG_DIR：ROS 日志目录。
# RMW_IMPLEMENTATION：ROS 中间件实现。
# FASTRTPS_DEFAULT_PROFILES_FILE：Fast DDS 配置文件。
# NVIDIA_DRIVER_CAPABILITIES：NVIDIA 容器驱动能力。
# MuJoCo container runtime paths. The host binds are defined in docker-compose.yml.
PROJECT_ROOT=/app
PROJECT_SOURCE_ROOT=/app/src
PROJECT_CONTAINER=1
PROJECT_USE_ROS=1
ROS_DOMAIN_ID=42
PROJECT_SETUP=/config/setup.sh
PROJECT_SOURCE_PATHS=/app/src:/contracts/python/src:/deps/backend_core:/deps/ros_support:/deps/run_logging
MUJOCO_GL=egl
PYOPENGL_PLATFORM=egl
ROS_LOG_DIR=/tmp/ros-logs
RMW_IMPLEMENTATION=rmw_fastrtps_cpp
FASTRTPS_DEFAULT_PROFILES_FILE=/config/fastdds.xml
NVIDIA_DRIVER_CAPABILITIES=compute,utility,graphics
