# MuJoCo/EGL 环境；宿主机路径由 Compose 声明。
CONTAINER_NAME=mujoco
SHARED_ROOT=/shared
DATA_ROOT=/data
BUILD_ROOT=/data/build
PROJECT_ROOT=/app
PROJECT_SOURCE_PREFIX=simulation/mujoco
PROJECT_SOURCE_ROOT=/app/src
PROJECT_CONTAINER=1
PROJECT_USE_ROS=1
ROS_DOMAIN_ID=42
PROJECT_SETUP=/shared/common/tools/docker/setup.sh
PROJECT_SOURCE_PATHS=/app/src:/shared/common/python/contracts/src:/shared/common/python/ros_support/src:/shared/common/python/run_logging/src:/shared/common/python/trajectory/src
MUJOCO_GL=egl
PYOPENGL_PLATFORM=egl
ROS_LOG_DIR=/tmp/ros-logs
RMW_IMPLEMENTATION=rmw_fastrtps_cpp
FASTRTPS_DEFAULT_PROFILES_FILE=/shared/common/tools/docker/fastdds.xml
NVIDIA_DRIVER_CAPABILITIES=compute,utility,graphics
