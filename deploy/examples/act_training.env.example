# DSH-041 ACT batch16 / 20K job environment.
#
# Copy this file outside the repository (for example to
# .build/reports/dsh-041/act_training.env), review every path, record hashes,
# then load it explicitly:
#
#   set -a
#   . /path/to/act_training.env
#   set +a
#
# UID/GID default to the local user (1000). Change them only when the host
# owner of $TRAIN_OUTPUT_ROOT differs.
TRAIN_PROJECT=sim-dual-arm-act-b16-20k-20261103
TRAIN_IMAGE=sim-dual-arm/learning:act-dev
TRAIN_UID=1000
TRAIN_GID=1000

# Frozen source worktree. dsh-041 is the candidate snapshot; the supervisor
# must record its HEAD/status/archive hash before starting and must not edit
# this worktree afterwards.
TRAIN_SOURCE_ROOT=/home/ljk/work/sim_dual_arm/.build/worktrees/dsh-041

# Accepted 45/5 LeRobot dataset (19676 train / 2160 validation frames).
TRAIN_DATA_ROOT=/home/ljk/work/sim_dual_arm/var/learning/panda_stack_learning_v1

# Original 45/5 campaign root. Its ./attempts directory is mounted at
# /source-data and must match the /source-data/... paths recorded in the
# accepted dataset manifest.
TRAIN_SOURCE_DATA_ROOT=/home/ljk/work/sim_dual_arm/var/campaigns/panda_stack_v1

# Pinned read-only LeRobot source and verified host virtualenv.
TRAIN_LEARNING_SOURCE=/home/ljk/work/sim_dual_arm/third_party/src/lerobot-act-v0.6.1
TRAIN_VENV=/home/ljk/work/sim_dual_arm/.build/learning-dev-venv

# Mount this directory (not .build/cache) so the weight resolves as
# /learning-cache/hub/checkpoints/resnet18-f37072fd.pth.
TRAIN_WEIGHTS=/home/ljk/work/sim_dual_arm/.build/cache/torch

# Frozen training YAML.
TRAIN_CONFIG=/home/ljk/work/sim_dual_arm/.build/worktrees/dsh-041/configs/learning/act_training_b16_20k.container.yaml

# Frozen container-bound filter. It must be produced with /learning-data and
# /source-data paths (and /workspace for its rule), then hashed and made
# read-only; the DSH-040 host-path candidate is not directly usable inside
# this container. See docs/act-b16-20k-training.md section 2.
TRAIN_FILTER=/home/ljk/work/sim_dual_arm/var/learning/experiments/act-static-b16-20k-20261103/training-filter.json

# Shared /output root. It must be var/learning itself because the append-only
# 14400 s budget ledger and lock are /output/training-budget.jsonl and
# /output/.training-budget.lock. Do not point this at the experiment subdir.
TRAIN_OUTPUT_ROOT=/home/ljk/work/sim_dual_arm/var/learning
