# ACT 学习端环境；使用本地缓存并保持离线。
CONTAINER_NAME=lerobot
SHARED_ROOT=/shared
DATA_ROOT=/data
BUILD_ROOT=/data/build
PROJECT_ROOT=/app
PROJECT_SOURCE_PREFIX=learning/lerobot
PROJECT_CONTAINER=1
PROJECT_USE_ROS=0
# Compose runs as the host UID, while the upstream image's home belongs to its own UID.
HOME=/tmp
# Each scenario sets HF_HOME from its cache_root when the operation starts.
HF_HOME=
POLICY_SDK_ROOT=/opt/policy-sdk
PROJECT_SETUP=/shared/common/tools/docker/setup.sh
PROJECT_SOURCE_PATHS=/app/src:/shared/common/python/run_logging/src:/shared/common/python/contracts/src:/third_party/src/lerobot-act-v0.6.1/src:/opt/policy-sdk
HF_HUB_OFFLINE=1
HF_DATASETS_OFFLINE=1
TRANSFORMERS_OFFLINE=1
NVIDIA_DRIVER_CAPABILITIES=compute,utility
