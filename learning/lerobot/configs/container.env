# 中文参数说明（维护时优先阅读本段）
# PROJECT_ROOT：容器内项目根目录。
# PROJECT_CONTAINER：标记当前运行在项目容器内。
# PROJECT_USE_ROS：学习端不加载 ROS。
# HOME：容器内可写 home 目录。
# PROJECT_SOURCE_PATHS：学习端 Python 源码和第三方源码路径。
# LEARNING_CACHE_ROOT：学习缓存根目录。
# HF_HOME/HF_HUB_OFFLINE/HF_DATASETS_OFFLINE/TRANSFORMERS_OFFLINE：HuggingFace 离线缓存设置。
# NVIDIA_DRIVER_CAPABILITIES：NVIDIA 容器驱动能力。
# ACT container paths, offline behavior and GPU driver capabilities.
PROJECT_ROOT=/workspace
PROJECT_CONTAINER=1
PROJECT_USE_ROS=0
# Compose runs as the host UID, while the upstream image's home belongs to its own UID.
HOME=/tmp
PROJECT_SOURCE_PATHS=/workspace/learning/lerobot/src:/workspace/libraries/run_logging/src:/third_party/src/lerobot-act-v0.6.1/src:/opt/policy-sdk
LEARNING_CACHE_ROOT=/data/learning/cache
HF_HOME=/data/learning/cache/hf
HF_HUB_OFFLINE=1
HF_DATASETS_OFFLINE=1
TRANSFORMERS_OFFLINE=1
NVIDIA_DRIVER_CAPABILITIES=compute,utility
