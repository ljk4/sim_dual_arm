# ROS 2 运行端环境；宿主机路径由 Compose 声明。
CONTAINER_NAME=runtime
SHARED_ROOT=/shared
PROJECT_ROOT=/app
PROJECT_SOURCE_PREFIX=runtime/ros2
PROJECT_CONTAINER=1
PROJECT_USE_ROS=1
ROS_DOMAIN_ID=42
ROS_SDK_ROOT=/build/ros-dev
POLICY_SDK_ROOT=/build/generated/policy-sdk
DATA_ROOT=/data
BUILD_ROOT=/build
PROJECT_SETUP=/shared/common/tools/docker/setup.sh
PROJECT_SOURCE_PATHS=/shared/common/python/contracts/src:/shared/common/python/ros_support/src:/shared/common/python/run_logging/src:/shared/common/python/trajectory/src:/app/ros/dual_arm_runtime:/build/generated/policy-sdk
ROS_LOG_DIR=/tmp/ros-logs
RMW_IMPLEMENTATION=rmw_fastrtps_cpp
FASTRTPS_DEFAULT_PROFILES_FILE=/shared/common/tools/docker/fastdds.xml
