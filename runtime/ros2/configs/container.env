# 中文参数说明（维护时优先阅读本段）
# PROJECT_ROOT：容器内项目根目录。
# PROJECT_CONTAINER：标记当前运行在项目容器内。
# PROJECT_USE_ROS：是否加载 ROS 环境。
# ROS_DOMAIN_ID：ROS 2 域 ID，三端必须一致。
# PROJECT_SOURCE_PATHS：容器内 Python 源码搜索路径。
# PROJECT_WORKSPACE_VERSION：工作区版本标记。
# ROS_LOG_DIR：ROS 日志目录。
# RMW_IMPLEMENTATION：ROS 中间件实现。
# FASTRTPS_DEFAULT_PROFILES_FILE：Fast DDS 配置文件。
# Runtime container paths and ROS settings; host bind paths remain in Compose.
PROJECT_ROOT=/workspace
PROJECT_CONTAINER=1
PROJECT_USE_ROS=1
ROS_DOMAIN_ID=42
PROJECT_SOURCE_PATHS=/workspace/contracts/python/src:/workspace/libraries/ros_support/src:/workspace/libraries/run_logging/src:/workspace/runtime/ros2/ros/dual_arm_runtime:/opt/policy-sdk
PROJECT_WORKSPACE_VERSION=runtime-current
ROS_LOG_DIR=/tmp/ros-logs
RMW_IMPLEMENTATION=rmw_fastrtps_cpp
FASTRTPS_DEFAULT_PROFILES_FILE=/workspace/infrastructure/docker/fastdds.xml
