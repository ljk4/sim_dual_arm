# ROS 2 运行端环境；宿主机路径由 Compose 声明。
SHARED_ROOT=/shared
PROJECT_ROOT=/workspace
PROJECT_CONTAINER=1
PROJECT_USE_ROS=1
ROS_DOMAIN_ID=42
ROS_SDK_ROOT=/build/ros-dev
POLICY_SDK_ROOT=/build/generated/policy-sdk
PROJECT_SETUP=/shared/common/tools/docker/setup.sh
PROJECT_SOURCE_PATHS=/shared/common/python/contracts/src:/shared/common/python/ros_support/src:/shared/common/python/run_logging/src:/shared/common/python/trajectory/src:/workspace/runtime/ros2/ros/dual_arm_runtime:/build/generated/policy-sdk
PROJECT_WORKSPACE_VERSION=runtime-current
ROS_LOG_DIR=/tmp/ros-logs
RMW_IMPLEMENTATION=rmw_fastrtps_cpp
FASTRTPS_DEFAULT_PROFILES_FILE=/shared/common/tools/docker/fastdds.xml
