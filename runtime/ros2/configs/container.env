# Runtime container paths and ROS settings; host bind paths remain in Compose.
PROJECT_ROOT=/workspace
PROJECT_CONTAINER=1
PROJECT_USE_ROS=1
ROS_DOMAIN_ID=42
PROJECT_SOURCE_PATHS=/workspace/contracts/python/src:/workspace/libraries/backend_core/src:/workspace/libraries/ros_support/src:/workspace/libraries/run_logging/src:/workspace/runtime/ros2/ros/dual_arm_runtime:/opt/policy-sdk
PROJECT_WORKSPACE_VERSION=runtime-current
ROS_LOG_DIR=/tmp/ros-logs
RMW_IMPLEMENTATION=rmw_fastrtps_cpp
FASTRTPS_DEFAULT_PROFILES_FILE=/workspace/infrastructure/docker/fastdds.xml
