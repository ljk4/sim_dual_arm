{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1
    },
    "schema_id": {
      "type": "string",
      "minLength": 1
    },
    "joint_names": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "camera_names": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "max_skew_ns": {
      "type": "integer",
      "minimum": 0
    },
    "max_age_ns": {
      "type": "integer",
      "minimum": 1
    }
  },
  "required": [
    "schema_version",
    "schema_id",
    "joint_names",
    "camera_names",
    "max_skew_ns",
    "max_age_ns"
  ]
}
