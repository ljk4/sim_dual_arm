{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1
    },
    "schema_id": {
      "type": "string",
      "minLength": 1
    },
    "command_space": {
      "const": "joint_position"
    },
    "joint_names": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "required": [
    "schema_version",
    "schema_id",
    "command_space",
    "joint_names"
  ]
}
