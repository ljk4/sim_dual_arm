# Starts the explicit task clock for one prepared plan.  A repeated
# request_id/content returns the original start time; a different request is
# rejected rather than extending the task budget.
robot_api_msgs/RunContext context
string episode_id
string request_id
string lease_id
uint64 task_epoch
string plan_digest
---
bool success
string reason
uint64 task_epoch
string plan_digest
builtin_interfaces/Time start_time
sim_api_msgs/TaskState state
