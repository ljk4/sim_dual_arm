# Bounded, read-only IK/teacher preparation.  It never executes a task action.
robot_api_msgs/RunContext context
string episode_id
string request_id
string lease_id
uint64 seed
---
bool success
string reason
uint64 task_epoch
string task_config_digest
string plan_digest
uint32 key_pose_count
uint32 collision_segment_count
float64 ik_max_position_error_m
float64 ik_max_orientation_error_rad
float64 planned_duration_s
# "teacher" when IK/teacher plan was built, "evaluation_only" otherwise.
string prepare_kind
